# Copy to .env.local and fill in. With nothing set, the app runs in DEMO mode
# (sample flights, no real bookings, no charges).

# Public URL of the site (used for Stripe return links)
BASE_URL=http://localhost:3000

# Brand shown in the header and emails
NEXT_PUBLIC_BRAND_NAME=R Travel

# --- Duffel (flights) ---
# Test token starts with duffel_test_ ; live with duffel_live_
# Get one at https://app.duffel.com (Developers > Access tokens)
DUFFEL_ACCESS_TOKEN=

# --- Stripe (customer payments) ---
# Required before using a duffel_live_ token. Test key starts with sk_test_
STRIPE_SECRET_KEY=

# --- Your markup, added to every order ---
# Fixed amount per order + percentage of the airline fare.
# Duffel charges $3 + 1% per order and cards cost ~2.9% + $0.30 of the full
# charge, so the percentage must stay above ~4% or large fares lose money.
MARKUP_FIXED=12
MARKUP_PERCENT=5
